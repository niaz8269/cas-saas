# Cache rules for the static files (goes at the top of public_html/.htaccess).
# Hashed build files never change under the same name; photos and images change rarely.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    <If "%{REQUEST_URI} =~ m#^/(photos|images|logos|wm)/#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
</IfModule>
